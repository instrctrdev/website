# Hostinger MySQL. Replace with the database username, password, and exact name
# shown in hPanel; URL-encode special characters in the password.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME"

# Admin Dashboard Secret / Password
ADMIN_SECRET="change_this_to_a_secure_admin_password"

# Server Port (optional, Hostinger / PM2 defaults to 3000 or process.env.PORT)
PORT=3000
